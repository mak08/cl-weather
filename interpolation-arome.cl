;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; AROME-specific interpolation for regional regular latitude/longitude grids.

(in-package "CL-WEATHER")

(defun arome-grid-coordinate (info lat lon)
  (declare (type gribinfo info)
           (double-float lat lon))
  (let* ((row (if (= 1 (gribinfo-j-scan-pos info))
                  (/ (- lat (gribinfo-lat-start info))
                     (gribinfo-j-inc info))
                  (/ (- (gribinfo-lat-start info) lat)
                     (gribinfo-j-inc info))))
         (start-lon (mod (gribinfo-lon-start info) 360d0))
         (query-lon (mod lon 360d0))
         (column (if (= 1 (gribinfo-i-scan-neg info))
                     (/ (mod (- start-lon query-lon) 360d0)
                        (gribinfo-i-inc info))
                     (/ (mod (- query-lon start-lon) 360d0)
                        (gribinfo-i-inc info))))
         (last-row (1- (gribinfo-lat-points info)))
         (last-column (1- (gribinfo-lon-points info))))
    (declare (double-float row column start-lon query-lon)
             (fixnum last-row last-column))
    (when (and (<= 0d0 row (float last-row 1d0))
               (<= 0d0 column (float last-column 1d0))
               (> (gribinfo-lat-points info) 1)
               (> (gribinfo-lon-points info) 1))
      (let* ((row0 (min (floor row) (- last-row 1)))
             (column0 (min (floor column) (- last-column 1))))
        (values row0 column0
                (coerce (- row row0) 'double-float)
                (coerce (- column column0) 'double-float))))))

(defun arome-grid-compatible-p (info-0 info-1)
  (and (= (gribinfo-grid-size info-0) (gribinfo-grid-size info-1))
       (= (gribinfo-lat-points info-0) (gribinfo-lat-points info-1))
       (= (gribinfo-lon-points info-0) (gribinfo-lon-points info-1))
       (= (gribinfo-lat-start info-0) (gribinfo-lat-start info-1))
       (= (gribinfo-lat-end info-0) (gribinfo-lat-end info-1))
       (= (gribinfo-lon-start info-0) (gribinfo-lon-start info-1))
       (= (gribinfo-lon-end info-0) (gribinfo-lon-end info-1))
       (= (gribinfo-i-inc info-0) (gribinfo-i-inc info-1))
       (= (gribinfo-j-inc info-0) (gribinfo-j-inc info-1))
       (= (gribinfo-i-scan-neg info-0) (gribinfo-i-scan-neg info-1))
       (= (gribinfo-j-scan-pos info-0) (gribinfo-j-scan-pos info-1))))

(defun arome-interpolate-field (uv row0 column0 row-weight column-weight)
  (let* ((info (uv-info uv))
         (u-values (uv-u-array uv))
         (v-values (uv-v-array uv))
         (lon-points (gribinfo-lon-points info))
         (i00 (+ (* row0 lon-points) column0))
         (i01 (1+ i00))
         (i10 (+ i00 lon-points))
         (i11 (1+ i10))
         (row-complement (- 1d0 row-weight))
         (column-complement (- 1d0 column-weight))
         (w00 (* row-complement column-complement))
         (w01 (* row-complement column-weight))
         (w10 (* row-weight column-complement))
         (w11 (* row-weight column-weight))
         (sum-weight 0d0)
         (u 0d0)
         (v 0d0)
         (speed 0d0)
         (missing-value (gribinfo-missing-value info))
         (bitmap-p (= 1 (gribinfo-bitmap-present info))))
    (declare (type uv uv)
             (fixnum row0 column0 lon-points i00 i01 i10 i11)
             (double-float row-weight column-weight row-complement
                           column-complement w00 w01 w10 w11 sum-weight
                           u v speed missing-value))
    (labels ((accumulate (index weight)
               (when (and (plusp weight)
                          (or (not bitmap-p)
                              (and (/= (aref u-values index) missing-value)
                                   (/= (aref v-values index) missing-value))))
                 (let ((u-value (aref u-values index))
                       (v-value (aref v-values index)))
                   (incf sum-weight weight)
                   (incf u (* weight u-value))
                   (incf v (* weight v-value))
                   (incf speed (* weight (enorm u-value v-value)))))))
      (accumulate i00 w00)
      (accumulate i01 w01)
      (accumulate i10 w10)
      (accumulate i11 w11))
    (when (plusp sum-weight)
      (values (/ u sum-weight)
              (/ v sum-weight)
              (/ speed sum-weight)
              t))))

(defun interpolate-arome-uv (fraction lat lon fc-0 fc-1)
  (let ((info-0 (uv-info fc-0))
        (info-1 (uv-info fc-1)))
    (unless (arome-grid-compatible-p info-0 info-1)
      (error "AROME forecast fields have incompatible grid geometry"))
    (multiple-value-bind (row0 column0 row-weight column-weight)
        (arome-grid-coordinate info-0 lat lon)
      (if (null row0)
          (values 0d0 0d0 0d0 0d0)
          (multiple-value-bind (u-0 v-0 speed-0 valid-0)
              (arome-interpolate-field fc-0 row0 column0 row-weight column-weight)
            (multiple-value-bind (u-1 v-1 speed-1 valid-1)
                (arome-interpolate-field fc-1 row0 column0 row-weight column-weight)
              (cond
                ((and valid-0 valid-1)
                 (let ((u (linear fraction u-0 u-1))
                       (v (linear fraction v-0 v-1))
                       (speed (linear fraction speed-0 speed-1)))
                   (values (angle u v) speed u v)))
                (valid-0
                 (values (angle u-0 v-0) speed-0 u-0 v-0))
                (valid-1
                 (values (angle u-1 v-1) speed-1 u-1 v-1))
                (t
                 (values 0d0 0d0 0d0 0d0)))))))))

;;; EOF
